{
  "bind_address": ":9200",
  "page_title": "Trading Dashboard",
  "refresh_interval_sec": 1,
  "broker_panel": {
    "title": "NATS and JetStream",
    "commands": [
      {
        "id": "core_subjects",
        "name": "Subjects and Subscribers",
        "section": "nats_core",
        "description": "Check which subjects exist in core NATS and who is subscribed to them.",
        "command": "/usr/bin/curl -sf 'http://127.0.0.1:8222/subsz?subs=1' | /usr/bin/jq"
      },
      {
        "id": "core_connections",
        "name": "Connection Health",
        "section": "nats_core",
        "description": "Inspect live connections, subscription counts, pending bytes, and per-connection traffic.",
        "command": "/usr/bin/curl -sf 'http://127.0.0.1:8222/connz?subs=1' | /usr/bin/jq '{server_id,total_connections,num_connections,slow_consumers,total_subscriptions:(.connections // [] | map(.subscriptions | length) | add),connections:((.connections // []) | map({cid,name,ip,port,subscriptions:(.subscriptions | length),pending_bytes,in_msgs,out_msgs}))}'"
      },
      {
        "id": "core_flow",
        "name": "Message Flow",
        "section": "nats_core",
        "description": "See total message and byte flow through the NATS server.",
        "command": "/usr/bin/curl -sf 'http://127.0.0.1:8222/varz' | /usr/bin/jq '{server_id,start,uptime,in_msgs,out_msgs,in_bytes,out_bytes,subscriptions,slow_consumers,mem,cpu,connections,total_connections}'"
      },
      {
        "id": "core_slow",
        "name": "Slow Consumers",
        "section": "nats_core",
        "description": "Find whether any NATS core clients are currently marked as slow consumers.",
        "command": "/usr/bin/curl -sf 'http://127.0.0.1:8222/connz?subs=1' | /usr/bin/jq '{slow_consumers,connections:((.connections // []) | map(select((.slow_consumer // false) == true) | {cid,name,ip,pending_bytes,in_msgs,out_msgs,subscriptions}))}'"
      },
      {
        "id": "js_streams",
        "name": "Stream Summary",
        "section": "jetstream",
        "description": "Inspect JetStream streams, subjects, message counts, storage, and consumer totals.",
        "command": "/opt/homebrew/bin/nats --server nats://127.0.0.1:4222 stream report"
      },
      {
        "id": "js_consumers",
        "name": "Consumer Pending and Lag",
        "section": "jetstream",
        "description": "Show per-stream consumer pending messages and lag across the active trading streams.",
        "command": "for s in TICKS_RAW CANDLE_RAW INDICES_RAW SIGNALS_STRATEGY TRADES_PAPER PNL_PAPER; do echo \"=== ${s} ===\"; /opt/homebrew/bin/nats --server nats://127.0.0.1:4222 consumer report \"$s\" || true; echo; done"
      },
      {
        "id": "js_ack_state",
        "name": "Ack State",
        "section": "jetstream",
        "description": "Show delivered sequence, ack floor, and pending ack state for each JetStream consumer.",
        "command": "for pair in 'TICKS_RAW marketdata-candle-builder-v2' 'CANDLE_RAW first-candle-strategy' 'CANDLE_RAW vwap-strategy-stock' 'CANDLE_RAW ldrb-strategy-stock' 'INDICES_RAW ldrb-strategy-index' 'SIGNALS_STRATEGY paper-engine-signals-v2' 'TRADES_PAPER paper-engine-recovery'; do set -- $pair; echo \"=== $1 / $2 ===\"; /opt/homebrew/bin/nats --server nats://127.0.0.1:4222 consumer info \"$1\" \"$2\" || true; echo; done"
      },
      {
        "id": "js_redelivery",
        "name": "Redeliveries",
        "section": "jetstream",
        "description": "Check which consumers are redelivering messages and whether ack backlogs are building.",
        "command": "for pair in 'TICKS_RAW marketdata-candle-builder-v2' 'CANDLE_RAW first-candle-strategy' 'CANDLE_RAW vwap-strategy-stock' 'CANDLE_RAW ldrb-strategy-stock' 'INDICES_RAW ldrb-strategy-index' 'SIGNALS_STRATEGY paper-engine-signals-v2'; do set -- $pair; echo \"=== $1 / $2 ===\"; /opt/homebrew/bin/nats --server nats://127.0.0.1:4222 consumer info \"$1\" \"$2\" | /usr/bin/awk '/Redelivered Messages|Outstanding Acks|Unprocessed Messages|Acknowledgment Floor|Last Delivered Message/ {print}'; echo; done"
      }
    ]
  },
