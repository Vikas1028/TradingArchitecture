{
  "env": "prod",
  "kafka": {
    "bootstrap_servers": "nats://127.0.0.1:4222",
    "group_id": "marketdata-candle-builder-v2",
    "ticks_topic": "ticks.raw",
    "stock_candles_topic": "candle.raw",
    "index_candles_topic": "indices.raw",
    "commit_interval_ms": 1000,
    "startup_replay_grace_sec": 120
  },
  "symbols": {
    "index_symbols": [
      "NIFTY",
      "BANKNIFTY"
    ]
  },
  "aggregation": {
    "timezone": "Asia/Kolkata",
    "flush_on_shutdown": true
  }
}
