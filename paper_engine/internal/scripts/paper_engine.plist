<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.paper_engine.service</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/paper_engine/cmd/paper_engine</string>
        <string>--config</string>
        <string>/usr/local/paper_engine/config/paper_engine_config.json</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/usr/local/paper_engine</string>

    <key>StandardOutPath</key>
    <string>/usr/local/paper_engine/logs/paper_engine.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/paper_engine/logs/paper_engine.log</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
