{
  "env": "prod",
  "kafka": {
    "bootstrap_servers": "nats://127.0.0.1:4222",
    "group_id": "first-candle-strategy",
    "candles_topic": "candle.raw",
    "signal_topic": "signals.strategy",
    "commit_interval_ms": 1000,
    "startup_replay_grace_sec": 120
  },
  "strategy": {
    "timezone": "Asia/Kolkata",
    "session_start": "09:15",
    "opening_candle_slot": 1,
    "move_threshold_pct": 0.5
  }
}
