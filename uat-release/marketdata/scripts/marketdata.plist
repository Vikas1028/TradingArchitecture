<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marketdata.service</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>until /usr/bin/nc -z 127.0.0.1 9092 &gt;/dev/null 2&gt;&amp;1; do sleep 2; done; exec /Users/vikasbhandekar/live_services/marketdata/cmd/marketdata --config /Users/vikasbhandekar/live_services/marketdata/config/marketdata_config.json</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vikasbhandekar/live_services/marketdata</string>

    <key>StandardOutPath</key>
    <string>/Users/vikasbhandekar/live_services/marketdata/logs/launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vikasbhandekar/live_services/marketdata/logs/launchd.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
